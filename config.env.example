# Kindle Daily Viewer configuration
# Copy to ~/.config/kdv/config.env and edit values.
# All variables are optional except KDV_VAULT.

# Required: path to your Obsidian vault
KDV_VAULT=/path/to/your/obsidian/vault

# Daily notes directory (relative to vault or absolute path)
# KDV_DAILY_DIR=/path/to/vault/daily/notes

# Server port (default: 8080)
# KDV_PORT=8080

# Login password (default: password)
# KDV_PASSWORD=your-password-here

# Daily feed files directory (default: $KDV_VAULT/feed)
# KDV_FEED_DIR=/path/to/feed/dir

# Git worktree directory for diff view (optional)
# KDV_WORKTREE_DIR=/path/to/worktrees

# Extra repos to show in diff view (comma-separated paths)
# KDV_EXTRA_REPOS=/path/to/repo1,/path/to/repo2

# Auto-detect GitHub Desktop repos and show dirty ones in diff view (default: false)
# KDV_GITHUB_DESKTOP=true

# Max bytes for diff output before truncation (default: 50000)
# KDV_DIFF_TRUNCATE=50000
